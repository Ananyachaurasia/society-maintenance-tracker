PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/society_tracker
JWT_SECRET=replace_with_a_long_random_string

# Overdue threshold in days — complaints not Resolved past this are flagged overdue
OVERDUE_DAYS=5

# SMTP config for email notifications (any free-tier provider works)
# e.g. Brevo (Sendinblue), Mailtrap, or Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
